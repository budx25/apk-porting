+void CCEGLView::onClientResized(int width, int height)
+{
+    // The game laid out its scenes for the current design size: keep it and scale to the new client
+    // area. Saved first because setFrameSize also overwrites the design size. A game that never chose
+    // a policy gets letterboxing (ShowAll).
+    CCSize design = m_obDesignResolutionSize;
+    ResolutionPolicy policy = m_eResolutionPolicy == kResolutionUnKnown ? kResolutionShowAll : m_eResolutionPolicy;
+    CCEGLViewProtocol::setFrameSize(width / m_fFrameZoomFactor, height / m_fFrameZoomFactor);
+    // not while the window is first sized (before the director uses this view): nothing to rescale yet
+    if (CCDirector::sharedDirector()->getOpenGLView() == this && design.width > 0 && design.height > 0)
+    {
+        setDesignResolutionSize(design.width, design.height, policy);
+    }
+}
