+        InlineEdit::active = NULL;
+        ShowWindow(InlineEdit::edit, SW_HIDE);
+    }
+    InlineEdit::live.erase(std::remove(InlineEdit::live.begin(), InlineEdit::live.end(), this), InlineEdit::live.end());
 }
 
